          "name": "List Delivery Types",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "",
                  "function getRandomInt(max) {",
                  "  return Math.floor(Math.random() * max);",
                  "}",
                  "",
                  "if (jsonData.data !== undefined && jsonData.data.length > 0) {",
                  "    const delieryTypes = jsonData.data",
                  "    const selectedDeliveryType = delieryTypes[getRandomInt(delieryTypes.length)]",
                  "    pm.environment.set(\"delivery_type_id\", selectedDeliveryType.id)",
                  "",
                  "    const entityName = 'delivery_type'",
                  "    const entities = [...delieryTypes]",
                  "    const bulkSelectedEntity1 = entities[getRandomInt(entities.length)]",
                  "    const bulkSelectedEntity2 = entities[getRandomInt(entities.length)]",
                  "    pm.environment.set(\"bulk_\"+entityName+\"_id_1\", bulkSelectedEntity1.id)",
                  "    pm.environment.set(\"bulk_\"+entityName+\"_id_2\", bulkSelectedEntity2.id)       ",
