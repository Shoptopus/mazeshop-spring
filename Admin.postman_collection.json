        {
          "name": "List Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "",
                  "function getRandomInt(max) {",
                  "  return Math.floor(Math.random() * max);",
                  "}",
                  "",
                  "if (jsonData.data !== undefined) {",
                  "    const products = jsonData.data",
                  "    const selectedProduct = products[getRandomInt(products.length)]",
                  "    pm.environment.set(\"product_id\", selectedProduct.id);",
                  "",
                  "    const entityName = 'product'",
                  "    const entities = [...products]",
                  "    const bulkSelectedEntity1 = entities[getRandomInt(entities.length)]",
                  "    const bulkSelectedEntity2 = entities[getRandomInt(entities.length)]",
                  "    pm.environment.set(\"bulk_\"+entityName+\"_id_1\", bulkSelectedEntity1.id)",
                  "    pm.environment.set(\"bulk_\"+entityName+\"_id_2\", bulkSelectedEntity2.id)    ",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
