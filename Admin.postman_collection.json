          "name": "List Payments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "",
                  "function getRandomInt(max) {",
                  "  return Math.floor(Math.random() * max);",
                  "}",
                  "",
                  "if (jsonData.data !== undefined && jsonData.data.length > 0) {",
                  "    const payments = jsonData.data",
                  "    const selectedPayment = payments[getRandomInt(payments.length)]",
                  "    pm.environment.set(\"payment_id\", selectedPayment.id)",
                  "",
                  "    const entityName = 'payment'",
                  "    const entities = [...payments]",
                  "    const bulkSelectedEntity1 = entities[getRandomInt(entities.length)]",
                  "    const bulkSelectedEntity2 = entities[getRandomInt(entities.length)]",
                  "    pm.environment.set(\"bulk_\"+entityName+\"_id_1\", bulkSelectedEntity1.id)",
